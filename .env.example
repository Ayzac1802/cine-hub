# Secret used to sign short-lived voter tokens. Set this in production to a strong random value.
VOTER_TOKEN_SECRET=replace-with-a-strong-secret
# Token TTL in seconds (optional). Defaults to 900 (15 minutes).
VOTER_TOKEN_TTL_SECONDS=900
# Base URL for links generated by the server. Optional; the route will try to use request headers if not set.
NEXT_PUBLIC_BASE_URL=http://localhost:4028

# Supabase realtime backend configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
NEXT_PUBLIC_EVENT_SESSION_ID=default-event-session
